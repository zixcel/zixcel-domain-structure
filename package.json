{
  "name": "@zixcel/domain-structure",
  "version": "0.10.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Bounded, deterministic DNS-name hierarchy and public-suffix projection",
  "files": [
    "dist",
    "README.md",
    "repository.toml",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mts && tsc -p tsconfig.json",
    "typecheck": "pnpm run build && tsc -p tsconfig.test.json",
    "test": "pnpm run build && node --test test/*.test.mts",
    "prepack": "pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "tldts": "7.4.18"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@10.29.3",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixcel/zixcel-domain-structure.git"
  }
}
